# Copy to `.env` in the repo root and adjust.

# Vision: stub | gemini | openai
VISION_PROVIDER=stub

# OCR (EasyOCR). Set false for faster local runs when using stub vision.
ENABLE_OCR=true

# Preprocessing (OpenCV pipeline before OCR / vision)
ENABLE_PREPROCESSING=true

# API keys (only needed for gemini / openai)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENAI_API_KEY=

# Optional: CORS for dev (e.g. http://127.0.0.1:5173 if not using Vite proxy)
# BACKEND_CORS_ORIGINS=http://127.0.0.1:5173

LOG_LEVEL=INFO
